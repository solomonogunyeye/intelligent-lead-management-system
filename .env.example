# LEADLIFT — Environment configuration template
# Copy this file to .env and supply real values for any secret-bearing settings.
# Real credentials must never be committed to version control.
# The application works using the defaults shown below; a .env file is optional.

# --- Database ---
# Path to the SQLCipher-encrypted SQLite database file.
DATABASE_PATH=leadlift/data/leadlift.db

# --- OCR (Tesseract) ---
# Full path to tesseract.exe if it is not on PATH (Windows example):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- AI Provider (Ollama) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=30

# --- Business Configuration ---
# Comma-separated list of services this business offers (used for priority matching).
BUSINESS_SERVICES=Web Development,Digital Marketing,SEO,Content Creation,Maintenance
# New inquiries unanswered beyond this threshold (in hours) get a priority boost.
STALE_HOURS=48
# Communication tone for response drafting.
COMMUNICATION_TONE=Professional

# --- Gmail Intake (optional) ---
# OAuth credentials obtained from the Google Cloud Console.
GMAIL_OAUTH_CLIENT_ID=
# Secret — do not commit.
GMAIL_OAUTH_CLIENT_SECRET=
# Secret — do not commit.
GMAIL_OAUTH_REFRESH_TOKEN=
# Secret — do not commit.
GMAIL_OAUTH_TOKEN_ENCRYPTION_KEY=
# Secret — do not commit.
GMAIL_CREDENTIALS_ENCRYPTION_KEY=
GMAIL_MAX_RETRIEVED_MESSAGES=100
GMAIL_MAX_MESSAGE_AGE_DAYS=30
GMAIL_USE_HTML_FALLBACK=true
# 0 = disabled, no background scanning.
GMAIL_SCAN_INTERVAL_SECONDS=0
GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1
GMAIL_API_TIMEOUT_SECONDS=30

# --- WhatsApp Business Intake (optional) ---
WHATSAPP_APP_ID=
# Secret — do not commit.
WHATSAPP_APP_SECRET=
# Secret — do not commit.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PH_NUMBER_ID=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_MODE=webhook
# Secret — do not commit.
WHATSAPP_VERIFY_TOKEN_CHECK=

# --- Instagram Professional Intake (optional) ---
INSTAGRAM_APP_ID=
# Secret — do not commit.
INSTAGRAM_APP_SECRET=
# Secret — do not commit.
INSTAGRAM_VERIFY_TOKEN=
# Secret — do not commit.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_PAGE_ID=

# --- Facebook Messenger Intake (optional) ---
FACEBOOK_APP_ID=
# Secret — do not commit.
FACEBOOK_APP_SECRET=
# Secret — do not commit.
FACEBOOK_VERIFY_TOKEN=
# Secret — do not commit.
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# --- Telegram Bot Intake (optional) ---
# Secret — do not commit.
TELEGRAM_BOT_TOKEN=
# Secret — do not commit.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# --- Website Form Intake (optional) ---
# Secret — do not commit.
WEBSITE_FORM_WEBHOOK_SECRET=
WEBSITE_FORM_MAX_PAYLOAD_BYTES=65536
WEBSITE_FORM_MAX_FIELD_LENGTH=10000

# --- Backup ---
BACKUP_DIR=leadlift/data/backups
BACKUP_RETENTION=10

# --- Logging ---
LOG_DIR=leadlift/data/logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
